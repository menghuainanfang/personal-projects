{
  "name": "readingos",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first reading, reflection and practice",
  "author": "ReadingOS contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build && node scripts/copy-pdf-assets.cjs",
    "test": "node --test tests/store.test.cjs tests/booklist.test.cjs tests/dates.test.cjs",
    "test:micro002": "node tests/micro002-desktop.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:v02": "node tests/v02-desktop.cjs",
    "screenshots": "node tests/visual.cjs after",
    "package": "npm run build && electron-builder --win nsis --x64",
    "notices": "node scripts/notices.cjs",
    "test:v03": "node tests/v03-desktop.cjs",
    "screenshots:v03": "node tests/v03-screens.cjs after"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@radix-ui/react-dialog": "^1.2.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@xmldom/xmldom": "0.8.15",
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "papaparse": "5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "org.readingos.desktop",
    "productName": "ReadingOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ReadingOS-${version}-win-x64-setup.${ext}"
    }
  }
}
